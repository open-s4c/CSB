{
  "plots": [
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "time",
      "y_lbl": "Total Time(s)",
      "hue": "execution_unit",
      "hue_lbl": "Executor",
      "shape": "barplot",
      "title": "bwrap maximum isolation launch time"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "avg_launch_time",
      "y_lbl": "Average Launch Time(s)",
      "hue": "execution_unit",
      "hue_lbl": "Executor",
      "shape": "barplot",
      "title": "bwrap maximum isolation average launch time"
    }
  ],
  "benchmark_config": {
    "exec_env": {
      "native": []
    },
    "monitors": {
      "mpstat": [
        "-n",
        "-u",
        "-I",
        "SCPU,SUM",
        "-P",
        "0"
      ],
      "perf": [
        "-C",
        "0",
        "--all-kernel"
      ]
    }
  },
  "containers": {
    "core_count": 1,
    "core_assignment_policy": {
      "cpu_order": "asc",
      "pack_group": "none",
      "one_cpu_per_core": true
    }
  },
  "applications": [
    {
      "path": "bm-external/bwrap",
      "name": "bm-bwrap.py",
      "args": "--index {index} --units {n_units} --iterations 1000 --scenario max --command /usr/bin/true"
    }
  ]
}
