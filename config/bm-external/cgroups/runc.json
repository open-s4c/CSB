{
  "plots": [
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "time",
      "y_lbl": "Total Time(s)",
      "hue": "execution_unit",
      "hue_lbl": "Executor",
      "shape": "barplot",
      "title": "Total container create/delete time"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "create_time",
      "y_lbl": "Create Time(s)",
      "hue": "execution_unit",
      "hue_lbl": "Executor",
      "shape": "barplot",
      "title": "runc create time"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "delete_time",
      "y_lbl": "Delete Time(s)",
      "hue": "execution_unit",
      "hue_lbl": "Executor",
      "shape": "barplot",
      "title": "runc delete time"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "cache-misses",
      "y_lbl": "Perf stat Cache-misses",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "Cache-misses vs. #Benchmark Instances",
      "shape": "barplot"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "branch-misses",
      "y_lbl": "Perf stat Branch-misses",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "Branch-misses vs. #Benchmark Instances",
      "shape": "barplot"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "faults",
      "y_lbl": "Perf stat faults",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "faults vs. #Benchmark Instances",
      "shape": "barplot"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "cgroup-switches",
      "y_lbl": "Perf stat cgroup-switches",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "cgroup-switches vs. #Benchmark Instances",
      "shape": "barplot"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "perf_lock_avg_wait",
      "y_lbl": "Average wait of all locks",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "Lock avg wait vs. #Benchmark Instances",
      "shape": "barplot"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "perf_lock_total_wait",
      "y_lbl": "Total wait of all locks",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "Lock avg wait vs. #Benchmark Instances",
      "shape": "barplot"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "bpf_cgroup_attach_task_hist",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "cgroup_attach_task",
      "type": "bpftrace_hist"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "bpf_cgroup_charge_hist",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "cgroup_charge",
      "type": "bpftrace_hist"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "bpf_cgroup_fork_hist",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "cgroup_fork",
      "type": "bpftrace_hist"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "bpf_cgroup_procs_write_hist",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "cgroup_procs_write",
      "type": "bpftrace_hist"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Benchmark Instances",
      "y": "bpf_cgroup_rstat_flush_hist",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "cgroup_rstat_flush",
      "type": "bpftrace_hist"
    }
  ],
  "benchmark_config": {
    "exec_env": {
      "native": []
    },
    "monitors": {
      "mpstat": [
        "-n",
        "-u",
        "-I",
        "SCPU,SUM",
        "-P",
        "0"
      ],
      "perf": [
        "-C",
        "0",
        "--all-kernel"
      ],
      "perf_stat": [
        "-C",
        "0",
        "-e",
        "cache-references,cache-misses,faults,cgroup-switches"
      ],
      "perf_lock": [
        "-C",
        "0"
      ],
      "iostat": [],
      "bpftrace": [
        "bpf_cgroup_attach_task_hist.bt",
        "bpf_cgroup_charge_hist.bt",
        "bpf_cgroup_fork_hist.bt",
        "bpf_cgroup_procs_write_hist.bt",
        "bpf_cgroup_rstat_flush_hist.bt"
      ]
    }
  },
  "containers": {
    "core_count": 1,
    "core_assignment_policy": {
      "cpu_order": "asc",
      "pack_group": "none",
      "one_cpu_per_core": true
    }
  },
  "applications": [
    {
      "path": "bm-external/cgroups",
      "name": "bm-cgroups.py",
      "args": "--index {index} --units {n_units} --iterations 100 --runtime runc --root ./bm-external/cgroups/"
    }
  ],
  "plugins": [
    {
      "name": "sudo",
      "exec_time": "with"
    }
  ]
}
