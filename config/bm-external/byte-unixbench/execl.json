{
  "plots": [
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "execl",
      "y_lbl": "Throughput(lps)",
      "hue_lbl": "Executer",
      "hue": "execution_unit",
      "shape": "barplot",
      "title": "Unixbench execl throughput (lps) vs. #container"
    }
  ],
  "benchmark_config": {
    "repeat": 6
  },
  "containers": {
    "core_count": 2
  },
  "applications": [
    {
      "path": "bm-external/byte-unixbench/UnixBench",
      "name": "Run",
      "cd": true,
      "args": "-c {threads} -i 1 -b -q execl",
      "adapter": {
        "name": "byte-unixbench-adapter.py"
      }
    }
  ]
}
