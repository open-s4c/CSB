{
  "plots": [
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "time",
      "y_lbl": "Time(s)",
      "hue_lbl": "Executer",
      "hue": "execution_unit",
      "shape": "barplot",
      "title": "Time needed to launch and destroy N containers"
    }
  ],
  "benchmark_config": {
    "exec_env" : ["native"],
    "duration": 10,
    "monitors": {
      "perf": [
        "-a",
        "--all-kernel"
       ]
    }
  },
  "containers": {
    "container_list": {
      "values": [
        [
          1, 6
        ]
      ]
    },
    "core_count": 1
  },
  "applications": [
    {
      "path": "bm-external",
      "name": "bm-cgroups.py",
      "args": "--instances 1 --duration {duration}"
    }
  ]
}
