{
  "plots": [
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "throughput_min",
      "y_lbl": "Throughput",
      "hue_lbl": "Executer",
      "hue": "execution_unit",
      "shape": "barplot",
      "title": "Throughput vs. #Containers"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "throughput_min",
      "y_lbl": "Throughput",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "Linearity vs. #Containers",
      "type": "linearity"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "sys_time",
      "y_lbl": "System Time",
      "hue": "execution_unit",
      "hue_lbl": "Executer",
      "shape": "barplot"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "univ_succ_count",
      "y_lbl": "Operation Success Count",
      "hue": "execution_unit",
      "hue_lbl": "Executer",
      "shape": "barplot"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "univ_count",
      "y_lbl": "Operation count",
      "hue": "execution_unit",
      "hue_lbl": "Executer",
      "shape": "barplot"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "op0_read_write",
      "y_lbl": "Operation min, max, avg",
      "hue": "execution_unit",
      "hue_lbl": "Executer",
      "shape": "barplot",
      "type": "min_max_avg"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "op0_read_write",
      "y_lbl": "Operation success percent",
      "hue": "execution_unit",
      "hue_lbl": "Executer",
      "shape": "barplot",
      "type": "success_percent"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "op0_read_write",
      "y_lbl": "Operation Histogram",
      "hue": "execution_unit",
      "hue_lbl": "Executer",
      "type": "histogram"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "branch-misses",
      "y_lbl": "Branch Misses",
      "hue": "execution_unit",
      "hue_lbl": "Executer"
    }
  ],
  "benchmark_config": {
    "duration": 10,
    "monitors": {
      "bpftrace": [
        "bpf_block_req_hist.bt",
        "bpf_cgroup_attach_task.bt",
        "bpf_cgroup_charge.bt",
        "bpf_cgroup_fork.bt",
        "bpf_cgroup_procs_write.bt",
        "bpf_cgroup_rstat_flush.bt",
        "bpf_copy_from_user.bt",
        "bpf_copy_to_user.bt",
        "bpf_cgroup_rstat_lock_count.bt",
        "bpf_ext4_mb_new_blocks.bt",
        "bpf_flush_tlb_mm_range_count.bt",
        "bpf_irq_handler.bt",
        "bpf_mutex_lock.bt",
        "bpf_native_queued_spin_lock_slowpath.bt",
        "bpf_page_fault_io_count.bt",
        "bpf_page_fault_kernel_count.bt",
        "bpf_page_fault_kvm_count.bt",
        "bpf_page_fault_user_count.bt",
        "bpf_path_init.bt",
        "bpf_queued_read_lock_slowpath.bt",
        "bpf_queued_write_lock_slowpath.bt",
        "bpf_raw_spin_lock.bt",
        "bpf_rwsem_down_read_slowpath.bt",
        "bpf_rwsem_down_write_slowpath.bt",
        "bpf_sched_domains_mutex.bt",
        "bpf_sched_fork_count.bt",
        "bpf_sched_latency.bt",
        "bpf_sched_migrate_task_count.bt",
        "bpf_vfs_read_latency.bt"
      ]
    }
  },
  "containers": {
    "container_list": {
      "values": [
        [
          5
        ]
      ]
    },
    "name": "redis-like",
    "port": 8000
  },
  "applications": [
    {
      "name": "bm_server_redis",
      "operations": [
        512,
        512
      ]
    }
  ],
  "plugins": [
    {
      "name": "launch-clients-local.sh",
      "exec_time": "pre",
      "force_stop": "True",
      "args": [
        "8000",
        "{n_units}",
        "{homedir}/build/bench/start",
        "{homedir}/build/bench"
      ]
    }
  ]
}
