{
  "plots": [
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "time",
      "y_lbl": "Time(s)",
      "hue_lbl": "Executer",
      "hue": "execution_unit",
      "shape": "barplot",
      "title": "Time needed to launch and destroy N containers"
    },
    {
      "x": "container_cnt",
      "x_lbl": "#Containers",
      "y": "time",
      "y_lbl": "Avg Time(s)",
      "hue": "execution_type",
      "hue_lbl": "Execution Env",
      "title": "Average Time vs. #Containers",
      "type": "mean"
    }

  ],
  "benchmark_config": {
    "exec_env" : ["native"],
    "duration": 10,
    "monitors": {
      "perf": [
        "-C",
        "0",
        "-e",
        "cycles:k"
       ]
    }
  },
  "containers": {
    "core_count": 1
  },
  "applications": [
    {
      "path": "bm-external/cgroups",
      "name": "bm-cgroups.py",
      "args": "--instances 1 --index {index}",
      "cd" : true
    }
  ]
}
