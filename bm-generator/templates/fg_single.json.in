{
	"plots": [
		{
			"x": "container_cnt",
			"x_lbl": "#Containers",
			"y": "throughput_min",
			"y_lbl": "Throughput",
			"hue_lbl": "Executer",
			"hue": "execution_unit",
			"shape": "barplot",
			"title" : "Throughput vs. #Containers"
		},
		{
			"x": "container_cnt",
			"x_lbl": "#Containers",
			"y": "throughput_min",
			"y_lbl": "Throughput",
			"hue": "execution_type",
			"hue_lbl": "Execution Env",
			"title": "Linearity vs. #Containers",
			"type": "linearity"
		},
		{
			"x": "container_cnt",
			"x_lbl": "#Containers",
			"y": "univ_succ_percent",
			"y_lbl": "Operations success percent",
			"hue_lbl": "Executer",
			"hue": "execution_unit",
			"shape": "barplot",
			"title" : "Success% vs. #Containers"
		}
	],
	"benchmark_config" : {
		"duration": 60,
		"exec_env": {
      		"native" : []
    	},
		"monitors" : {"perf" : ["-C", "0"]}
	},
	"containers": {
		"container_list": {"values": [[1]]},
		$_begin(META_NAME = [[1]]);
		"port" : 5000,
		$_end();
		"core_count": 1
    },
    "applications": [
$_begin(BINNAME = [[1; 2]]);
        { "name": "BINNAME","operations": [1024]}
$_end();
    ],
"plugins": [
$_begin(META_NAME = [[1; 2]], GROUP_NAME = [[gen-ws]]);
	 {
		"name": "network-agent.sh",
		"exec_time": "pre",
		"force_stop": "True",
		"args": [
			"5000",
			"{n_units}",
			"{homedir}/build/bench/network",
			"{homedir}/bench/targets/GROUP_NAME/syz/META_NAME"
		]
	 },
$_end();
	{
		"name": "clean-syz.sh",
		"exec_time": "cleanup",
		"args": [
			"{homedir}"
		]
	}
  ]
}
